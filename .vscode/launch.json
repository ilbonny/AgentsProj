{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (Ollama Chat)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/OllamaAgentChat/bin/Debug/net8.0/OllamaAgentChat.dll",
      "args": [],
      "cwd": "${workspaceFolder}/OllamaAgentChat",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/chat"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/OllamaAgentChat/Views"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
